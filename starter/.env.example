# Copy this file to .env in THIS project folder, then fill in your networks.
# Keep .env private. Use 2.4 GHz Wi-Fi; captive portals/enterprise login are unsupported.
# Values are literal: $, # and backslashes are kept as typed.
HOME_WIFI_SSID=""
HOME_WIFI_PASSWORD=""

# Optional office fallback. Leave password blank only for an approved open network.
OFFICE_WIFI_SSID=""
OFFICE_WIFI_PASSWORD=""

# Live build uses Wi-Fi when 1. Offline starter always forces Wi-Fi off.
WORKSHOP_LIVE=1
